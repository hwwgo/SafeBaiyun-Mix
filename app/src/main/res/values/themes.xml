<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SafeBaiyun" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 小部件开锁时使用的“小悬浮窗”主题：仅在 MainActivity 被小部件拉起时通过 setTheme 切换，
         正常点图标启动仍用不透明的 Theme.SafeBaiyun。
         关键：windowIsFloating=true 让窗口按内容大小自适应（只包住解锁小卡片，不再铺满全屏），
         窗口自身透明、不压暗背后内容，于是四周自然透出真实的桌面/壁纸，既提示“正在解锁”，
         又不会出现全屏黑屏。配合 UnlockLightweight 的小卡片（带阴影）呈现为居中浮窗。 -->
    <style name="Theme.SafeBaiyun.Translucent" parent="Theme.SafeBaiyun">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <!-- ShortcutActivity 专用的“小悬浮窗”主题：窗口浮动、按内容自适应、背景透明、不压暗桌面，
         由 UnlockLightweight 的小卡片呈现为居中浮窗。与 Theme.SafeBaiyun.Translucent 效果一致，
         保证桌面快捷方式与小部件两套入口的开锁提示界面统一。
         注：浮动窗口默认即为居中（与普通 Dialog 一致），故无需额外设置 windowGravity。 -->
    <style name="Theme.ShortcutDialog" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

</resources>
